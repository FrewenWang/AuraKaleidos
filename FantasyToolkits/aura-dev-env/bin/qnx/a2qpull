#!/usr/bin/env bash
set -euo pipefail
: "${AURA_QNX_HOST:?请设置 AURA_QNX_HOST}"
: "${SSHPASS:?请通过 SSHPASS 设置 QNX 密码}"
file=$1

adb root
adb remount

expect << EOF
    set timeout -1
    spawn adb shell
    expect "e171" { send "mkdir /data/local/tmp\r" }
    expect "e171" { send "rm -r /data/local/tmp/`basename $file`\r" }
    expect "e171" { send "echo `basename $file`\r" }
    expect "e171" { send "busybox ftpget -u root -p ${SSHPASS} ${AURA_QNX_HOST} /data/local/tmp/$(basename $file) $file\r" }
    expect "e171" { send "exit\r" }
    expect eof
EOF

adb pull /data/local/tmp/`basename $file`

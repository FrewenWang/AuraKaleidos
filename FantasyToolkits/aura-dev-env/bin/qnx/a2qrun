#!/usr/bin/env bash
set -euo pipefail
: "${AURA_QNX_HOST:?请设置 AURA_QNX_HOST}"
: "${SSHPASS:?请通过 SSHPASS 设置 QNX 密码}"
if test -z $*
then
    cmd="sh"
else
    cmd="$*"
fi
echo $cmd
adb root
adb remount
expect << EOF
    set timeout -1
    spawn adb shell

    expect "e171" { send "busybox telnet ${AURA_QNX_HOST} ; exit\r" }
    expect "login" { send "root\r" }
    expect "Password" { send "${SSHPASS}\r" }
    expect "#" { send "$cmd\r" }
    expect "#" { send "exit\r" }
    expect eof
EOF

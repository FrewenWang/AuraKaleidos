#!/bin/bash

#!/usr/bin/env bash
set -e

# ==============================
# Usage check
# ==============================
if [ $# -ne 1 ]; then
  echo "Usage: $0 <0|1>"
  echo "  1 : Force Open SE"
  echo "  0 : Close Force Open SE"
  exit 1
fi

OPEN_LOG="$1"

if ! [[ "$OPEN_LOG" =~ ^[01]$ ]]; then
  echo "ERROR: argument must be 0 or 1"
  exit 1
fi

# ==============================
# ADB prepare
# ==============================
adb wait-for-device
adb root
adb wait-for-device
adb remount

# ==============================
# se open control functions
# ==============================
se_open_mempool() {
  echo "============= SE OPEN MEM_POOL =========================="
  adb shell setprop persist.vendor.camera.algo.xiaomi.mage.mem_pool.se 1,3,50
  echo "Result:"
  adb shell getprop persist.vendor.camera.algo.xiaomi.mage.mem_pool.se
}

se_close_mempool() {
  echo "============= SE CLOSE MEM_POOL=========================="
  adb shell setprop persist.vendor.camera.algo.xiaomi.mage.mem_pool.se 0
  echo "Result:"
  adb shell getprop persist.vendor.camera.algo.xiaomi.mage.mem_pool.se
}

# ==============================
# Main logic
# ==============================
if [ "$OPEN_LOG" -eq 1 ]; then
  se_open_mempool
else
  se_close_mempool
fi

# ==============================
# Restart camera services
# ==============================
echo "============= Restart camera services ==============="

mi-kcam

echo "============= Done ================================"

QNN_CONVERTER_ROOT="${QNN_CONVERTER_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
export ENV_PROJECT_ROOT_DIR="${ENV_PROJECT_ROOT_DIR:-${QNN_CONVERTER_ROOT}}"
: "${ENV_ONNX_MODEL_NAME:?Set ENV_ONNX_MODEL_NAME before sourcing jdd_env.env}"
export ENV_ONNX_MODEL_NAME
export ENV_OVERRIDE_JSON_PATH="${ENV_OVERRIDE_JSON_PATH:-${ENV_PROJECT_ROOT_DIR}/onnx/${ENV_ONNX_MODEL_NAME}.encodings}"

export ENV_AISP_DUMP_DIR="${ENV_AISP_DUMP_DIR:-${ENV_PROJECT_ROOT_DIR}/dump}"
export ENV_AISP_DUMP_FOLDER="${ENV_AISP_DUMP_FOLDER:-model_dump}"

export ENV_TEST_LIST="${ENV_TEST_LIST:-${ENV_PROJECT_ROOT_DIR}/input_data/input_list.txt}"
export ENV_CALIB_LIST="${ENV_CALIB_LIST:-${ENV_PROJECT_ROOT_DIR}/input_data/input_list.txt}"

export ENV_ACT_BITWIDTH=16
export ENV_WEIGHT_BITWIDTH=8
export ENV_ACT_QUANT=mse
export ENV_QUANT_METHOD=pcq_act${ENV_ACT_QUANT}_qnn
export ENV_MODEL_DIR=${ENV_ONNX_MODEL_NAME}_W${ENV_WEIGHT_BITWIDTH}A${ENV_ACT_BITWIDTH}${ENV_QUANT_METHOD}_out8

echo "ENV_PROJECT_ROOT_DIR=${ENV_PROJECT_ROOT_DIR}"
echo "ENV_ONNX_MODEL_NAME=${ENV_ONNX_MODEL_NAME}"
echo "ENV_OVERRIDE_JSON_PATH=${ENV_OVERRIDE_JSON_PATH}"

echo "ENV_AISP_DUMP_DIR=${ENV_AISP_DUMP_DIR}"
echo "ENV_AISP_DUMP_FOLDER=${ENV_AISP_DUMP_FOLDER}"

echo "ENV_TEST_LIST=${ENV_TEST_LIST}"
echo "ENV_CALIB_LIST=${ENV_CALIB_LIST}"

echo "ENV_MODEL_DIR=${ENV_MODEL_DIR}"

#!/usr/bin/expect -f

if {![info exists env(AURA_QNX_HOST)] || $env(AURA_QNX_HOST) eq ""} {
    puts stderr "请设置 AURA_QNX_HOST"
    exit 2
}
if {![info exists env(SSHPASS)] || $env(SSHPASS) eq ""} {
    puts stderr "请通过 SSHPASS 设置 QNX 密码"
    exit 2
}

spawn adb root
spawn adb remount
spawn adb shell

expect "e171" { send "busybox telnet $env(AURA_QNX_HOST); exit\r" }
expect "login" { send "root\r" }
expect "Password" { send "$env(SSHPASS)\r" }
expect "#" { send "mount -uw /mnt/vendor/adas\r" }
expect "#" { send "sed -i 's/output_encode_data :.*/output_encode_data : true/g' /mnt/vendor/adas/conf/drivers/camera_data.conf\r" }
expect "#" { send "cat /mnt/vendor/adas/conf/drivers/camera_data.conf\r" }
expect "#" { send "mount -ur /mnt/vendor/adas\r" }
expect "#" { send "exit\r" }

interact

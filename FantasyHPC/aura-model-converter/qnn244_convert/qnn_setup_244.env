


TOP_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")"; pwd)

host_3rdparty_dir=/data/3rdparty

if [ ! -d $host_3rdparty_dir ];
then
    echo "$host_3rdparty_dir not exist."
    exit 1
fi

# if [ -f .envinited.tmp ]; #if env already setup
# then
#     echo "env already setup."
#     exit 0
# fi
echo "setup env."

NDK_VER=r25c
QNN_VER=2.44.0.260225

echo "host_3rdparty_dir: $host_3rdparty_dir"
#android NDK
echo "NDK_VER : $NDK_VER"
NDK_DIR="${host_3rdparty_dir}/ndk/android-ndk-${NDK_VER}"
echo "NDK_DIR:$NDK_DIR"
export ANDROID_NDK_ROOT=$NDK_DIR
export NDK_ROOT=$NDK_DIR
export PATH=$ANDROID_NDK_ROOT:$PATH


# export HEXAGON_VER="6.2.0.1"
# echo "HEXAGON_VER : $HEXAGON_VER"
# export HEXAGON_SDK_PATH=${host_3rdparty_dir}/hexagon/${HEXAGON_VER}
# echo "HEXAGON_SDK_PATH : $HEXAGON_SDK_PATH"
# source $HEXAGON_SDK_PATH/setup_sdk_env.source


# qnn env
echo "QNN_VER : $QNN_VER"
export QNN_SDK_ROOT=$host_3rdparty_dir/qnn/$QNN_VER
echo "QNN_SDK_ROOT : $QNN_SDK_ROOT"
source  $QNN_SDK_ROOT/bin/envsetup.sh


# ptq_tools env setup
export PYTHONPATH=$TOP_DIR/3rdparty/:$PYTHONPATH
echo "PYTHONPATH: $PYTHONPATH"

export LD_LIBRARY_PATH=$QNN_SDK_ROOT/lib/python/qti/aisw/converters/common/linux-x86_64/
echo "LD_LIBRARY_PATH : $LD_LIBRARY_PATH"
# touch .envinited.tmp

#!/usr/local/bin/bash
# ============================================================
# 🔧 NDK 版本管理工具
# ============================================================
# 用法：
#   ndk                     查看当前 NDK 版本信息
#   ndk <版本号>            切换 NDK 版本（如 r27d、r26d、r25c）
#   ndk -v / --version      查看当前 NDK 版本信息
#   ndk -l / --list         列出所有支持的 NDK 版本
#   ndk -h / --help         显示帮助信息
#
# 版本映射在 toolkit_versions.conf 中统一管理，直接修改配置即可。
# ============================================================

# ========================
# 📦 加载配置文件
# ========================
# 配置文件在项目根目录的 config/ 下
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG_FILE="$PROJECT_ROOT/config/toolkit_versions.conf"

if [ -f "$CONFIG_FILE" ]; then
  source "$CONFIG_FILE"
else
  # 如果配置文件不存在，定义基本的颜色和函数
  C_RESET='\033[0m'
  C_BOLD='\033[1m'
  C_RED='\033[31m'
  error() { echo -e "${C_RED}❌ $*${C_RESET}"; }
  error "找不到配置文件: $CONFIG_FILE"
  exit 1
fi

# ========================
# 🔀 版本映射函数
# ========================
# 将用户输入的友好名称映射到实际版本号（直接读 map）
get_mapped_version() {
  local result="${NDK_VERSION_MAP[$1]}"
  echo "${result:-$1}" # 找不到则原样返回
}

# ==========================
# 📋 版本映射表（从配置文件动态生成）
# ==========================
# NDK_VERSION_MAP 和 NDK_VERSION_DESC 由配置文件提供

# 显示版本映射表
show_version_map() {
  echo ""
  echo -e "  ${C_BOLD}┌─────────┬────────────────┬──────────────────────────┐${C_RESET}"
  echo -e "  ${C_BOLD}│ 友好名称 │ 版本号          │ 说明                     │${C_RESET}"
  echo -e "  ${C_BOLD}├─────────┼────────────────┼──────────────────────────┤${C_RESET}"
  for key in $(echo "${!NDK_VERSION_MAP[@]}" | tr ' ' '\n' | sort); do
    local ver="${NDK_VERSION_MAP[$key]}"
    local desc="${NDK_VERSION_DESC[$key]:-}"
    printf "  ${C_BOLD}│${C_RESET} %-7s ${C_BOLD}│${C_RESET} %-14s ${C_BOLD}│${C_RESET} %-24s ${C_BOLD}│${C_RESET}\n" \
      "$key" "$ver" "$desc"
  done
  echo -e "  ${C_BOLD}└─────────┴────────────────┴──────────────────────────┘${C_RESET}"
}

# ========================
# 🔍 模糊匹配建议
# ========================
suggest_similar_versions() {
  local input="$1"
  local suggestions=()

  for key in "${!NDK_VERSION_MAP[@]}"; do
    local ver="${NDK_VERSION_MAP[$key]}"
    # 前缀匹配或子串匹配
    if [[ "$key" == *"$input"* ]] || [[ "$input" == *"$key"* ]] ||
      [[ "$ver" == *"$input"* ]] || [[ "$input" == *"$ver"* ]]; then
      suggestions+=("$key ($ver)")
    fi
  done

  if [ ${#suggestions[@]} -gt 0 ]; then
    echo ""
    warn "您是否想找："
    for s in "${suggestions[@]}"; do
      echo -e "    ${C_CYAN}→${C_RESET} $s"
    done
  fi
}

# ========================
# 🔎 查找匹配的 NDK 目录
# ========================
find_ndk_path() {
  local version=$1
  local mapped_version

  mapped_version=$(get_mapped_version "$version")

  # 首先检查映射后的版本
  if [ "$mapped_version" != "$version" ]; then
    local ndk_path="$NDK_BASE_PATH/$mapped_version"
    if [ -d "$ndk_path" ]; then
      echo "$ndk_path"
      return 0
    fi
  fi

  # 尝试直接匹配 android-ndk-<version> 格式
  local ndk_path="$NDK_BASE_PATH/android-ndk-$version"
  if [ -d "$ndk_path" ]; then
    echo "$ndk_path"
    return 0
  fi

  # 尝试匹配纯数字版本
  ndk_path="$NDK_BASE_PATH/$version"
  if [ -d "$ndk_path" ]; then
    echo "$ndk_path"
    return 0
  fi

  echo ""
  return 1
}

# ========================
# ℹ️  显示当前版本信息
# ========================
show_version() {
  header "📱 当前 NDK 信息"
  echo -e "  ${C_GRAY}$(printf '═%.0s' {1..50})${C_RESET}"

  if [ -L "$NDK_LINK_PATH" ]; then
    local current_target
    current_target=$(readlink "$NDK_LINK_PATH")
    local current_version
    current_version=$(basename "$current_target")

    # 反向查找友好名称
    local friendly_name
    friendly_name=$(get_ndk_friendly_name "$current_version")

    echo -e "  当前版本:   ${C_GREEN}${C_BOLD}${friendly_name:-$current_version}${C_RESET}"
    echo -e "  版本号:     ${C_CYAN}$current_version${C_RESET}"
    echo -e "  实际路径:   ${C_DIM}$current_target${C_RESET}"
    echo -e "  符号链接:   ${C_DIM}$NDK_LINK_PATH${C_RESET}"
    echo ""

    if [ -d "$NDK_LINK_PATH" ]; then
      echo -e "  ${C_BOLD}NDK 目录结构 (前 10 项):${C_RESET}"
      find "$NDK_LINK_PATH" -maxdepth 1 -mindepth 1 | head -10 | while IFS= read -r line; do
        echo -e "    ${C_GRAY}$(basename "$line")${C_RESET}"
      done
    fi
  else
    warn "当前未设置 NDK 符号链接"
    echo -e "  符号链接: ${C_DIM}$NDK_LINK_PATH (不存在)${C_RESET}"
  fi

  # 显示可用版本
  echo ""
  header "📦 可用 NDK 版本"
  if [ -d "$NDK_BASE_PATH" ]; then
    local count=0
    for dir in "$NDK_BASE_PATH"/*/; do
      if [ -d "$dir" ] && [ "$(basename "$dir")" != "ndk-home" ]; then
        local dirname
        dirname=$(basename "$dir")
        local friendly_name=""
        friendly_name=$(get_ndk_friendly_name "$dirname")

        count=$((count + 1))
        if [ -n "$friendly_name" ]; then
          echo -e "    ${C_GREEN}✓${C_RESET} ${C_CYAN}$dirname${C_RESET} ${C_GRAY}($friendly_name)${C_RESET}"
        else
          echo -e "    ${C_GREEN}✓${C_RESET} $dirname"
        fi
      fi
    done
    if [ $count -eq 0 ]; then
      echo -e "    ${C_GRAY}(无已安装的 NDK 版本)${C_RESET}"
    fi
  else
    error "NDK 基础目录不存在: $NDK_BASE_PATH"
  fi

  # 显示版本映射表
  header "🔀 版本映射表"
  show_version_map

  # 验证 ndk-build
  if command -v ndk-build > /dev/null 2>&1; then
    echo ""
    header "🔨 ndk-build 版本"
    ndk-build --version 2> /dev/null | while IFS= read -r line; do
      echo -e "    ${C_GRAY}$line${C_RESET}"
    done
  fi
}

# ========================
# 📋 列出所有支持的版本
# ========================
show_list() {
  header "📋 支持的 NDK 版本"
  echo ""

  echo -e "  ${C_BOLD}预定义版本映射:${C_RESET}"
  show_version_map

  echo ""
  header "📂 已安装的 NDK 版本"
  echo -e "  基础路径: ${C_DIM}$NDK_BASE_PATH${C_RESET}"
  echo ""

  if [ -d "$NDK_BASE_PATH" ]; then
    local count=0
    for dir in "$NDK_BASE_PATH"/*/; do
      if [ -d "$dir" ] && [ "$(basename "$dir")" != "ndk-home" ]; then
        local dirname
        dirname=$(basename "$dir")

        # 反向查找友好名称（从 map 中查）
        local friendly_name=""
        for key in "${!NDK_VERSION_MAP[@]}"; do
          if [ "${NDK_VERSION_MAP[$key]}" = "$dirname" ]; then
            if [ -z "$friendly_name" ]; then
              friendly_name="$key"
            else
              friendly_name="$friendly_name/$key"
            fi
          fi
        done

        count=$((count + 1))
        if [ -n "$friendly_name" ]; then
          echo -e "    ${C_GREEN}✓${C_RESET} ${C_CYAN}$dirname${C_RESET} ${C_GRAY}($friendly_name)${C_RESET}"
        else
          echo -e "    ${C_GREEN}✓${C_RESET} $dirname"
        fi
      fi
    done
    if [ $count -eq 0 ]; then
      echo -e "    ${C_GRAY}(无已安装的 NDK 版本)${C_RESET}"
    fi
  else
    error "NDK 基础目录不存在: $NDK_BASE_PATH"
  fi

  echo ""
  header "💡 使用方式"
  echo -e "    ${C_CYAN}ndk <版本号>${C_RESET}      切换到指定版本"
  echo -e "    ${C_CYAN}ndk r26d${C_RESET}          切换到 NDK r26d 版本"
  echo -e "    ${C_CYAN}ndk --list${C_RESET}        列出所有版本"
  echo -e "    ${C_CYAN}ndk --version${C_RESET}     查看当前版本"
}

# ========================
# ❓ 显示帮助信息
# ========================
show_help() {
  echo ""
  echo -e "${C_BOLD}${C_CYAN}  🔧 NDK 版本管理工具${C_RESET}"
  echo -e "  ${C_GRAY}$(printf '═%.0s' {1..40})${C_RESET}"
  echo ""
  echo -e "  ${C_BOLD}用法:${C_RESET}"
  echo -e "    ${C_CYAN}ndk${C_RESET}                     查看当前 NDK 版本信息"
  echo -e "    ${C_CYAN}ndk -v, --version${C_RESET}       查看当前 NDK 版本信息"
  echo -e "    ${C_CYAN}ndk -l, --list${C_RESET}          查看所有支持的 NDK 版本"
  echo -e "    ${C_CYAN}ndk -h, --help${C_RESET}          显示此帮助信息"
  echo -e "    ${C_CYAN}ndk <版本号>${C_RESET}            切换 NDK 版本"
  echo ""
  echo -e "  ${C_BOLD}支持版本:${C_RESET}"
  for key in $(echo "${!NDK_VERSION_MAP[@]}" | tr ' ' '\n' | sort); do
    local ver="${NDK_VERSION_MAP[$key]}"
    local desc="${NDK_VERSION_DESC[$key]:-}"
    printf "    ${C_GREEN}%-6s${C_RESET} → %-14s ${C_GRAY}%s${C_RESET}\n" "$key" "$ver" "$desc"
  done
  echo ""
  echo -e "  ${C_BOLD}示例:${C_RESET}"
  echo -e "    ${C_CYAN}ndk r25c${C_RESET}   切换到 NDK r25c"
  echo -e "    ${C_CYAN}ndk r26d${C_RESET}   切换到 NDK r26d"
  echo -e "    ${C_CYAN}ndk r27d${C_RESET}   切换到 NDK r27d (最新)"
  echo -e "    ${C_CYAN}ndk 25.2.9519653${C_RESET}  使用完整版本号切换"
  echo ""
}

# ========================
# 🚀 主逻辑
# ========================
main() {
  # 如果没有参数，显示版本信息
  if [[ $# -eq 0 ]]; then
    show_version
    return 0
  fi

  local arg=$1

  case "$arg" in
    -v | --version)
      show_version
      return 0
      ;;
    -l | --list)
      show_list
      return 0
      ;;
    -h | --help)
      show_help
      return 0
      ;;
  esac

  # 处理切换版本命令
  local VERSION=$arg

  # 检查 NDK 基础目录是否存在
  if [ ! -d "$NDK_BASE_PATH" ]; then
    error "NDK 基础目录不存在！"
    echo -e "  路径: ${C_DIM}$NDK_BASE_PATH${C_RESET}"
    exit 1
  fi

  # 查找匹配的 NDK 目录
  local MATCHED_NDK_PATH
  MATCHED_NDK_PATH=$(find_ndk_path "$VERSION")

  if [ -z "$MATCHED_NDK_PATH" ]; then
    error "找不到版本 ${C_BOLD}$VERSION${C_RESET} 对应的 NDK 目录！"
    echo ""

    # 模糊匹配建议
    suggest_similar_versions "$VERSION"

    echo ""
    echo -e "  ${C_BOLD}已安装的目录:${C_RESET}"
    for dir in "$NDK_BASE_PATH"/*/; do
      if [ -d "$dir" ] && [ "$(basename "$dir")" != "ndk-home" ]; then
        echo -e "    ${C_CYAN}→${C_RESET} $(basename "$dir")"
      fi
    done

    echo ""
    echo -e "  ${C_BOLD}版本映射表:${C_RESET}"
    show_version_map
    exit 1
  fi

  # 获取映射信息用于显示
  local MAPPED_VERSION
  MAPPED_VERSION=$(get_mapped_version "$VERSION")

  # 获取友好名称
  local FRIENDLY_NAME
  FRIENDLY_NAME=$(get_ndk_friendly_name "$MAPPED_VERSION")

  # 更新符号链接
  rm -f "$NDK_LINK_PATH"
  ln -s "$MATCHED_NDK_PATH" "$NDK_LINK_PATH"

  echo ""
  if [ "$MAPPED_VERSION" != "$VERSION" ]; then
    success "已切换至 NDK ${C_BOLD}${FRIENDLY_NAME:-$VERSION}${C_RESET}"
    info "映射关系: ${C_CYAN}$VERSION${C_RESET} → ${C_CYAN}$MAPPED_VERSION${C_RESET}"
  else
    success "已切换至 NDK ${C_BOLD}${FRIENDLY_NAME:-$VERSION}${C_RESET}"
  fi
  echo -e "  实际路径: ${C_DIM}$MATCHED_NDK_PATH${C_RESET}"
  echo -e "  符号链接: ${C_DIM}$NDK_LINK_PATH${C_RESET}"
  echo ""
}

# 运行主函数
main "$@"

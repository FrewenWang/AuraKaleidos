#!/usr/bin/env bash
set -euo pipefail
: "${AURA_QNX_HOST:?请设置 AURA_QNX_HOST}"
: "${SSHPASS:?请通过 SSHPASS 设置 QNX 密码}"
adb root
adb remount

expect << EOF
    spawn adb shell

    expect "e171" { send "busybox telnet ${AURA_QNX_HOST}; exit\r" }
    expect "login" { send "root\r" }
    expect "Password" { send "${SSHPASS}\r" }
    expect "#" { send "rm -r /var/log/perf/*\r" }
    expect "#" { send "rm -r /var/log/slog/*\r" }
    expect "#" { send "rm -r /var/log/pavaro_record*.bag/*\r" }
    expect "#" { send "sh /mnt/vendor/adas/scripts/recordbag.sh\r" }
    expect "#" { send "exit\r" }
    expect eof
EOF
